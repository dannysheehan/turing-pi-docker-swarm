---
# Copy to local.yml and replace every deployment-specific value.
cluster_cidr: 192.0.2.0/24
admin_cidr: 192.0.2.0/24
network_gateway: 192.0.2.1
swarm_vip: 192.0.2.60
swarm_expected_cluster_id: replace-with-existing-swarm-id
timezone: Etc/UTC

nfs_server: 192.0.2.2
nfs_export: /replace/with/nfs/export

# Central syslog receiver for node log forwarding (RFC5424 / UDP).
log_shipping_server: nas.home.example.com

# Public hostnames served by Traefik. komodo_host is derived from komodo_domain.
traefik_domain: traefik.home.example.com
komodo_domain: komodo.home.example.com
traefik_acme_email: admin@example.com

# Komodo database: FerretDB in the Swarm, over an external PostgreSQL host that
# carries the DocumentDB extension. The DBA owns that host and must have
# installed the extension in komodo_pg_database and granted komodo_db_user
# membership of documentdb_admin_role.
komodo_pg_host: 192.0.2.99

# The password is embedded verbatim in the FerretDB postgres:// URL, so it must
# be 20-128 alphanumeric characters with no symbols or whitespace.
komodo_pg_password_secret_reference: op://Turing-Pi/Komodo/postgres-password
komodo_admin_username_secret_reference: op://Turing-Pi/Komodo/admin-username
komodo_admin_password_secret_reference: op://Turing-Pi/Komodo/admin-password
komodo_jwt_secret_reference: op://Turing-Pi/Komodo/jwt-secret
# Optional after enabling 2FA for the initialization administrator. Both
# references must be configured together and belong to an administrator key.
komodo_onboarding_api_key_secret_reference: ""
komodo_onboarding_api_secret_secret_reference: ""
