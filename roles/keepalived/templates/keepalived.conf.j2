global_defs {
    router_id {{ inventory_hostname | replace('-', '_') | upper }}
    enable_script_security
    script_user root
}

vrrp_script check_swarm_manager {
    script "/usr/local/sbin/check-swarm-manager"
    interval 2
    timeout 2
    fall 2
    rise 2
}

vrrp_instance swarm_front {
    state BACKUP
    nopreempt
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}
    priority {{ keepalived_priority }}
    advert_int 1
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for manager in groups['managers'] if manager != inventory_hostname %}
        {{ hostvars[manager].ansible_host }}
{% endfor %}
    }
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    track_script {
        check_swarm_manager
    }
    virtual_ipaddress {
        {{ swarm_vip }}/{{ swarm_vip_prefix }} dev {{ keepalived_interface }}
    }
}
