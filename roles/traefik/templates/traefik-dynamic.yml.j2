http:
  routers:
    komodo:
      entryPoints:
        - websecure
      rule: Host(`{{ komodo_domain }}`)
      service: komodo
      tls: {}

    traefik_ping:
      entryPoints:
        - websecure
      rule: Host(`{{ traefik_domain }}`) && Path(`/ping`)
      service: ping@internal
      tls: {}

  services:
    komodo:
      loadBalancer:
        servers:
          - url: {{ traefik_komodo_backend_url }}
{% if traefik_cert_enabled | bool %}

# Certificates supplied by the file provider, so no router needs a
# certResolver. Traefik picks a certificate by SNI; the default store below
# replaces the built-in TRAEFIK DEFAULT CERT for anything not matched, so a
# name outside the certificate fails visibly rather than silently serving a
# self-signed one.
tls:
  stores:
    default:
      defaultCertificate:
        certFile: /run/secrets/traefik_tls_cert
        keyFile: /run/secrets/traefik_tls_key
  certificates:
    - certFile: /run/secrets/traefik_tls_cert
      keyFile: /run/secrets/traefik_tls_key
{% endif %}
