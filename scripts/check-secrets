#!/usr/bin/env python3
"""Fail when detect-secrets finds an unallowlisted public-tree candidate."""

from __future__ import annotations

import json
import subprocess
import sys


EXCLUDED_FILES = (
    # Historical plans are not part of the public runtime configuration scan.
    r"(^|/)(\.git|\.venv|\.ansible|collections/ansible_collections|"
    r"group_vars/all/(local|vault)\.yml|hosts\.yml|"
    r"plans/.*\.md|uv\.lock)(/|$)"
)


def main() -> int:
    result = subprocess.run(
        [
            "detect-secrets",
            "scan",
            "--all-files",
            "--exclude-files",
            EXCLUDED_FILES,
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    findings = json.loads(result.stdout).get("results", {})
    if not findings:
        print("Public-tree secret scan passed.")
        return 0

    print("Potential secrets found in public-tree files:", file=sys.stderr)
    for path, candidates in sorted(findings.items()):
        for candidate in candidates:
            print(
                f"  {path}:{candidate['line_number']}: {candidate['type']}",
                file=sys.stderr,
            )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
