---
managers:
  hosts:
    tpi-mgr-01:
      ansible_host: 192.0.2.51
      keepalived_priority: 100
    tpi-mgr-02:
      ansible_host: 192.0.2.52
      keepalived_priority: 90
    tpi-mgr-03:
      ansible_host: 192.0.2.53
      keepalived_priority: 80

workers:
  hosts:
    tpi-wrk-01:
      ansible_host: 192.0.2.54
    tpi-wrk-02:
      ansible_host: 192.0.2.55
    tpi-wrk-03:
      ansible_host: 192.0.2.56
    tpi-wrk-04:
      ansible_host: 192.0.2.57

# Exactly one host, and it must match swarm_primary_manager in
# group_vars/all/main.yml -- roles assert the two agree. Any manager will do;
# change both together when the current one is retired or fails.
primary_manager:
  hosts:
    tpi-mgr-02:

cluster:
  children:
    managers:
    workers:
